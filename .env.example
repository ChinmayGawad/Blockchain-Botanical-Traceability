# ==============================================================================
# FloraChain Environment Configuration Template
# Duplicate this file to .env and configure for your local or production network
#
# NEVER commit a filled-in copy of this file: `.env` is git-ignored and the
# pre-commit hook rejects staged secret files.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND / CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
# Backend Spring Boot REST API Endpoint
VITE_API_BASE_URL=http://localhost:8080/api

# Optional collector for client side error reports (see src/services/errorReporting.ts).
# Leave empty to keep reports in the browser console only.
VITE_ERROR_REPORTING_URL=

# Target Blockchain Network Configuration:
# - 31337   : Hardhat Local Node (http://127.0.0.1:8545)
# - 80002   : Polygon Amoy Testnet (Recommended for public testnet testing)
# - 137     : Polygon PoS Mainnet (Production)
# - 11155111: Ethereum Sepolia Testnet
VITE_CHAIN_ID=31337
VITE_RPC_URL=http://127.0.0.1:8545
VITE_EXPLORER_URL=

# Deployed Smart Contract Address (Updated automatically after running deploy:contracts)
VITE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Mapbox GL Access Token (pk.* public token for farm geolocation & partner mapping)
# Get a free token at https://account.mapbox.com
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here

# ------------------------------------------------------------------------------
# 2. SMART CONTRACT & BLOCKCHAIN DEPLOYMENT (HARDHAT)
# ------------------------------------------------------------------------------
# Deployer Account Private Key (NEVER commit your actual production private key!)
# Required when deploying to public testnets/mainnet (Amoy, Sepolia, Polygon)
PRIVATE_KEY=

# Public RPC Endpoints (Optional: Override default public RPC with dedicated Alchemy/Infura)
POLYGON_AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
POLYGON_MAINNET_RPC_URL=https://polygon-rpc.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Block Explorer API Keys (for automatic source code verification)
# Get a free API key at https://polygonscan.com or https://etherscan.io
POLYGONSCAN_API_KEY=
ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=
BASESCAN_API_KEY=

# Optional: Seed sample initial botanical batch on-chain during production deployment
SEED_DEMO_DATA=false

# ------------------------------------------------------------------------------
# 3. BACKEND PRODUCTION SETTINGS (SPRING BOOT 3)
# ------------------------------------------------------------------------------
# Active Spring Profile (dev = H2 in-memory, prod = PostgreSQL)
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Production Database Settings
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/florachain_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgrespassword

# ------------------------------------------------------------------------------
# 4. SECRETS (environment only - never hard coded, never committed)
# ------------------------------------------------------------------------------
# JWT signing secret. The prod profile refuses to start without a value that
# provides at least 256 bit (32 bytes) of entropy. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Relayer key used to submit provenance transactions to the chain.
BLOCKCHAIN_RELAYER_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 5. API SECURITY LIMITS
# ------------------------------------------------------------------------------
# Requests per minute allowed on /api/auth/** (login & registration)
RATE_LIMIT_AUTH_PER_MINUTE=15
# Requests per minute allowed on the remaining API endpoints
RATE_LIMIT_GENERAL_PER_MINUTE=180

# ------------------------------------------------------------------------------
# 6. BACKEND WEB3j BLOCKCHAIN CONNECTION
# ------------------------------------------------------------------------------
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
BLOCKCHAIN_NETWORK_NAME=Hardhat EVM Localhost (Chain ID 31337)

# ------------------------------------------------------------------------------
# 7. DECENTRALIZED IPFS STORAGE (PINATA)
# ------------------------------------------------------------------------------
# Free Pinata account at https://app.pinata.cloud
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/
PINATA_API_KEY=
PINATA_SECRET_KEY=
PINATA_JWT=
IPFS_MOCK_MODE=true

# ------------------------------------------------------------------------------
# 8. CORS ALLOWED ORIGINS (For production backend)
# ------------------------------------------------------------------------------
CORS_FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 9. LOGGING
# ------------------------------------------------------------------------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
